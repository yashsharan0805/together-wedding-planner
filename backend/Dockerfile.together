FROM ruby:4.0.7-slim
WORKDIR /rails
ENV RAILS_ENV=development
RUN apt-get update -qq && apt-get install --no-install-recommends -y \
    build-essential git libpq-dev libvips pkg-config libyaml-dev curl nodejs \
    && rm -rf /var/lib/apt/lists/*
COPY Gemfile Gemfile.lock ./
RUN --mount=type=secret,id=corporate_ca \
    if [ -s /run/secrets/corporate_ca ]; then \
      cp /run/secrets/corporate_ca /usr/local/share/ca-certificates/together-corporate-ca.crt \
      && update-ca-certificates; \
    fi \
    && gem install bundler -v 4.0.13 && bundle install
COPY . .
EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
